# --- User instances (required) ---
LITELLM_API_URL=
LITELLM_API_KEY=
OPENWEBUI_API_URL=
OPENWEBUI_API_KEY=

# --- OpenRouter (optional, enriches model catalog) ---
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# --- Refresh / cache ---
REFRESH_INTERVAL_SECONDS=3600
CACHE_TTL_SECONDS=3600
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=3
STARTUP_REFRESH=true

# --- LiteLLM cost map validation thresholds (keep defaults) ---
MODEL_COST_MAP_MIN_MODEL_COUNT=50
MODEL_COST_MAP_MAX_SHRINK_RATIO=0.5

# --- Server ---
PORT=8000
LOG_LEVEL=INFO